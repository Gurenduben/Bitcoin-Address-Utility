<UserControl x:Class="BtcAddress.Views.EscrowHowItWorksView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBox x:Name="txtHowItWorks"
                 IsReadOnly="True"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 AcceptsReturn="True" />

        <TextBlock Grid.Row="1" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Hyperlink Click="DisclaimerLink_Click">DISCLAIMER OF WARRANTY</Hyperlink>
        </TextBlock>
    </Grid>
</UserControl>
