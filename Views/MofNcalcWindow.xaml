<Window x:Class="BtcAddress.Views.MofNcalcWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MofNcalc"
        Height="365"
        Width="618"
        Loaded="Window_Loaded">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock VerticalAlignment="Center" Text="Parts to require (m)" />
            <ComboBox x:Name="numPartsNeeded" Width="46" Margin="6,0,16,0" SelectedIndex="2">
                <ComboBoxItem Content="1" />
                <ComboBoxItem Content="2" />
                <ComboBoxItem Content="3" />
                <ComboBoxItem Content="4" />
                <ComboBoxItem Content="5" />
                <ComboBoxItem Content="6" />
                <ComboBoxItem Content="7" />
                <ComboBoxItem Content="8" />
            </ComboBox>
            <TextBlock VerticalAlignment="Center" Text="Parts to generate (n)" />
            <ComboBox x:Name="numPartsToGenerate" Width="46" Margin="6,0,16,0" SelectedIndex="4">
                <ComboBoxItem Content="1" />
                <ComboBoxItem Content="2" />
                <ComboBoxItem Content="3" />
                <ComboBoxItem Content="4" />
                <ComboBoxItem Content="5" />
                <ComboBoxItem Content="6" />
                <ComboBoxItem Content="7" />
                <ComboBoxItem Content="8" />
            </ComboBox>
            <Button x:Name="btnGenerate" Width="212" Height="25" Content="Generate m-of-n with new random key" Click="BtnGenerate_Click" />
        </StackPanel>

        <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,0,8,4" VerticalAlignment="Center" Text="Part 1" />
        <TextBox x:Name="txtPart1" Grid.Row="1" Grid.Column="1" Margin="0,0,0,4" />

        <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,0,8,4" VerticalAlignment="Center" Text="Part 2" />
        <TextBox x:Name="txtPart2" Grid.Row="2" Grid.Column="1" Margin="0,0,0,4" />

        <TextBlock Grid.Row="3" Grid.Column="0" Margin="0,0,8,4" VerticalAlignment="Center" Text="Part 3" />
        <TextBox x:Name="txtPart3" Grid.Row="3" Grid.Column="1" Margin="0,0,0,4" />

        <TextBlock Grid.Row="4" Grid.Column="0" Margin="0,0,8,4" VerticalAlignment="Center" Text="Part 4" />
        <TextBox x:Name="txtPart4" Grid.Row="4" Grid.Column="1" Margin="0,0,0,4" />

        <TextBlock Grid.Row="5" Grid.Column="0" Margin="0,0,8,4" VerticalAlignment="Center" Text="Part 5" />
        <TextBox x:Name="txtPart5" Grid.Row="5" Grid.Column="1" Margin="0,0,0,4" />

        <TextBlock Grid.Row="6" Grid.Column="0" Margin="0,0,8,4" VerticalAlignment="Center" Text="Part 6" />
        <TextBox x:Name="txtPart6" Grid.Row="6" Grid.Column="1" Margin="0,0,0,4" />

        <TextBlock Grid.Row="7" Grid.Column="0" Margin="0,0,8,4" VerticalAlignment="Center" Text="Part 7" />
        <TextBox x:Name="txtPart7" Grid.Row="7" Grid.Column="1" Margin="0,0,0,4" />

        <TextBlock Grid.Row="8" Grid.Column="0" Margin="0,0,8,4" VerticalAlignment="Center" Text="Part 8" />
        <TextBox x:Name="txtPart8" Grid.Row="8" Grid.Column="1" Margin="0,0,0,4" />

        <Grid Grid.Row="9" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,6,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button x:Name="btnGenerateSpecific" Grid.Column="0" Width="248" Height="31" Content="Generate m-of-n for specific private key" Click="BtnGenerateSpecific_Click" />
            <Button x:Name="btnDecode" Grid.Column="2" Width="96" Height="24" Content="Decode m-of-n" Click="BtnDecode_Click" />
        </Grid>

        <TextBlock Grid.Row="10" Grid.Column="0" Margin="0,8,8,0" VerticalAlignment="Center" Text="Private key" />
        <TextBox x:Name="txtPrivKey" Grid.Row="10" Grid.Column="1" Margin="0,8,0,0" />

        <TextBlock Grid.Row="11" Grid.Column="0" Margin="0,6,8,0" VerticalAlignment="Center" Text="Address" />
        <TextBox x:Name="txtAddress" Grid.Row="11" Grid.Column="1" Margin="0,6,0,0" />
    </Grid>
</Window>
