<UserControl x:Class="BtcAddress.Views.EscrowRedeemView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" TextWrapping="Wrap" Margin="0,0,0,8">
                Paste all three redeem codes to recover funds.
            </TextBlock>

            <TextBox x:Name="txtRedeemCode1" Grid.Row="1" Margin="0,0,0,6" />
            <TextBox x:Name="txtRedeemCode2" Grid.Row="2" Margin="0,0,0,6" />
            <TextBox x:Name="txtRedeemCode3" Grid.Row="3" Margin="0,0,0,8" />

            <Button x:Name="btnRedeem" Grid.Row="4" Content="Redeem" Width="110" Click="BtnRedeem_Click" Margin="0,0,0,8" />

            <Label Grid.Row="5" Content="Private key:" />
            <TextBox x:Name="txtRedeemPrivKey" Grid.Row="6" Margin="0,0,0,8" IsReadOnly="True" />

            <Label Grid.Row="7" Content="Address:" />
            <TextBox x:Name="txtRedeemAddress" Grid.Row="8" IsReadOnly="True" />
        </Grid>
    </ScrollViewer>
</UserControl>

