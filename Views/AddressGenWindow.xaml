<Window x:Class="BtcAddress.Views.AddressGenWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Generate Addresses"
        Height="293"
        Width="400"
        WindowStartupLocation="CenterOwner"
        Closing="Window_Closing">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Number of addresses to generate" />
        <TextBox x:Name="txtGenCount" Grid.Row="1" Width="90" HorizontalAlignment="Left" Text="8" Margin="43,4,0,0" />

        <GroupBox x:Name="groupBox1" Grid.Row="0" Grid.RowSpan="4" Header="Private key type" Margin="186,0,0,0">
            <StackPanel Margin="8">
                <RadioButton x:Name="rdoMiniKeys" Content="MiniKey" IsChecked="True" Checked="RdoWalletType_CheckedChanged" />
                <RadioButton x:Name="rdoRandomWallet" Content="Full-length (WIF)" Margin="0,2,0,0" Checked="RdoWalletType_CheckedChanged" />
                <RadioButton x:Name="rdoEncrypted" Content="Passphrase Encrypted" Margin="0,2,0,0" Checked="RdoWalletType_CheckedChanged" />
                <RadioButton x:Name="rdoTwoFactor" Content="Two-Factor Encrypted" Margin="0,2,0,0" Checked="RdoWalletType_CheckedChanged" />
                <RadioButton x:Name="rdoDeterministicWallet" Content="Deterministic (WIF)" Margin="0,2,0,0" Checked="RdoWalletType_CheckedChanged" />
            </StackPanel>
        </GroupBox>

        <CheckBox x:Name="chkRetainPrivKey" Grid.Row="3" Content="Retain unencrypted private key" Visibility="Collapsed" />

        <TextBlock x:Name="lblTextInput" Grid.Row="4" Text="Seed for deterministic generation" Visibility="Collapsed" />
        <TextBox x:Name="txtTextInput" Grid.Row="5" Visibility="Collapsed" Margin="0,4,0,0" />

        <Button x:Name="btnGenerateAddresses" Grid.Row="6" Content="Generate Addresses" Width="173" Height="36" HorizontalAlignment="Center" Margin="0,10,0,0" Click="BtnGenerateAddresses_Click" />

        <DockPanel Grid.Row="7" Margin="0,10,0,0" LastChildFill="True">
            <ProgressBar x:Name="progressBar" Width="100" Height="16" DockPanel.Dock="Right" Visibility="Collapsed" Minimum="0" />
            <TextBlock x:Name="statusText" VerticalAlignment="Center" Margin="0,0,8,0" />
        </DockPanel>
    </Grid>
</Window>
