<Window x:Class="BtcAddress.Views.PrintVouchersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Print Vouchers"
        Height="260"
        Width="308"
        WindowStartupLocation="CenterOwner"
        Loaded="Window_Loaded">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Text="Vouchers to print per page" />
        <TextBox x:Name="txtVouchersPerPage" Grid.Row="0" Grid.Column="1" Width="65" HorizontalAlignment="Right" Text="3" />

        <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="0,8,0,0" Text="Artwork style" />
        <ComboBox x:Name="cboArtworkStyle" Grid.Row="1" Grid.Column="1" Margin="8,8,0,0">
            <ComboBoxItem Content="Yellow" />
            <ComboBoxItem Content="Green" />
            <ComboBoxItem Content="Blue" />
            <ComboBoxItem Content="Purple" />
            <ComboBoxItem Content="Greyscale" />
        </ComboBox>

        <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Margin="0,8,0,0" Text="Denomination to print" />
        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="8,8,0,0">
            <TextBlock Margin="0,2,6,0" Foreground="DarkBlue" Cursor="Hand" Text="฿" MouseLeftButtonUp="DenominationSymbol_Click" />
            <TextBlock Margin="0,2,6,0" Foreground="DarkBlue" Cursor="Hand" Text="Ƀ" MouseLeftButtonUp="DenominationSymbol_Click" />
            <TextBox x:Name="txtDenomination" Width="127" />
        </StackPanel>

        <CheckBox x:Name="chkPrintUnencrypted" Grid.Row="4" Grid.ColumnSpan="2" Margin="0,10,0,0" Content="Print unencrypted version of private keys" Visibility="Collapsed" />

        <Button x:Name="btnPrint" Grid.Row="6" Grid.ColumnSpan="2" Margin="0,12,0,0" Height="31" Content="Print" Click="BtnPrint_Click" />
    </Grid>
</Window>
