<Window x:Class="BtcAddress.Views.PpecKeygenWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Intermediate Passphrase Generator"
        Height="240"
        Width="832"
        MinHeight="240">
    <Grid Margin="9">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0"
                   Grid.Column="0"
                   Grid.ColumnSpan="3"
                   TextWrapping="Wrap"
                   Margin="0,0,0,8"
                   Text="This screen generates an Intermediate Passphrase as described by BIP 38 (Bitcoin Improvement Proposal 38).&#x0a;&#x0a;Enter a passphrase, and an Intermediate Passphrase Code will be generated.  You can give this code to someone else,&#x0a;and they can use it to create encrypted Bitcoin addresses that require your original passphrase to spend.  The other party can add&#x0a;funds to the addresses but cannot spend funds from them.&#x0a;&#x0a;The intermediate code is generated using the well-known algorithm called &quot;scrypt&quot;.  As long as the passphrase is reasonably strong, the&#x0a;original passphrase cannot be recovered from the intermediate code." />

        <Label Grid.Row="1" Grid.Column="0" Content="Passphrase" VerticalAlignment="Center" Margin="0,0,10,0" />
        <TextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" x:Name="txtPassphrase" />

        <Label Grid.Row="2" Grid.Column="0" Content="Intermediate&#x0a;Passphrase Code" VerticalAlignment="Center" Margin="0,8,10,0" />
        <Button Grid.Row="2" Grid.Column="1" x:Name="btnEncode" Margin="0,8,6,0" Width="128" Height="29" Content="Encode passphrase" Click="BtnEncode_Click" />
        <TextBox Grid.Row="2" Grid.Column="2" x:Name="txtPassphraseCode" Margin="0,8,0,0" />

        <TextBlock Grid.Row="3"
                   Grid.Column="1"
                   Grid.ColumnSpan="2"
                   Margin="0,8,0,0"
                   TextWrapping="Wrap"
                   Text="Generating passphrases and encrypting and decrypting keys is slow by design. Expect several seconds delay." />
    </Grid>
</Window>



